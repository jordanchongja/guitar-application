# Copy this file to .streamlit/secrets.toml (local dev) and fill in real
# values, OR paste the same TOML into your Streamlit Community Cloud app's
# Settings -> Secrets box (for the deployed app). See README.md "Persistent
# storage (Google Sheets)" for the full step-by-step setup.
#
# .streamlit/secrets.toml is already in .gitignore -- never commit your real
# credentials.

# These settings must stay above the first [section]: TOML puts every line after a [section]
# heading inside that section.
# Practice tracker (Practice + Pathway pages)
app_password = "choose-a-password"          # needed to log/edit; the rest of the app stays public
recordings_script_url = "https://script.google.com/macros/s/.../exec"  # see tools/recordings_apps_script.gs
recordings_token = "random-string-also-pasted-into-the-script"
practice_timezone = "Asia/Singapore"
owner_email = "you@gmail.com"               # the Google account that unlocks logging; see README.md


[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
client_email = "guitar-app@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/guitar-app%40your-gcp-project-id.iam.gserviceaccount.com"

[gsheet]
# The long ID in the spreadsheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
spreadsheet_id = "1AbCDeFGhIJkLmNoPQRsTuVWxyZ0123456789abcdefg"

# "Sign in with Google" (optional): see README.md.
[auth]
redirect_uri = "https://guitar-application.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
